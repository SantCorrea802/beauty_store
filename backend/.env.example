# =========================================================
# Local PostgreSQL for docker-compose
# =========================================================
POSTGRES_DB=beauty_store
POSTGRES_USER=beauty_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

# =========================================================
# Spring datasource
# =========================================================
DB_URL=jdbc:postgresql://127.0.0.1:5433/beauty_store
DB_USERNAME=beauty_user
DB_PASSWORD=change_me

# =========================================================
# Application identity
# =========================================================
APP_BRAND_NAME=Hajuvi

# =========================================================
# JWT
# Use a long, random secret. Do not commit real secrets.
# =========================================================
JWT_SECRET=change_me_with_at_least_32_random_chars
JWT_EXPIRES_MINUTES=480
JWT_ISSUER=hajuvi-backend

# =========================================================
# CORS
# =========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =========================================================
# Cloudinary
# =========================================================
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
CLOUDINARY_PRODUCT_IMAGES_FOLDER=hajuvi/dev/products

# =========================================================
# Business contact
# =========================================================
BUSINESS_WHATSAPP_NUMBER=573001234567

# =========================================================
# Customer links
# =========================================================
CUSTOMER_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
CUSTOMER_EMAIL_VERIFICATION_TOKEN_EXPIRES_MINUTES=1440
CUSTOMER_PASSWORD_RESET_URL=http://localhost:5173/reset-password
CUSTOMER_PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# =========================================================
# Email provider: dev | smtp | resend-api
# =========================================================
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@hajuvi.com
EMAIL_FROM_NAME=Hajuvi

# SMTP, only when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=false

# Resend API, only when EMAIL_PROVIDER=resend-api
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# =========================================================
# Runtime tuning
# =========================================================
JPA_SHOW_SQL=false
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=6MB
PORT=8080
